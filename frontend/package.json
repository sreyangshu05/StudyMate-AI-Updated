    "react-hot-toast": "^2.4.1",
    "framer-motion": "^10.16.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.9.0",
    "happy-dom": "^14.0.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.62.1",
