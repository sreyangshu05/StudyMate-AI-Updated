# ==============================================================================
# StudyMate backend environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ==============================================================================

# --- Server ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# --- Auth ---
# REQUIRED. Use a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database / storage ---
# SQLite (default). Paths are relative to backend/.
DATABASE_PATH=./data/studymate.db
STORAGE_PATH=./uploads

# --- AI (OpenRouter or any OpenAI-compatible endpoint) ---
# REQUIRED for AI features (embeddings, Q&A, chat, quiz generation).
# Either OPENROUTER_API_KEY or OPENAI_API_KEY.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# --- Upload limits (MB) ---
MAX_UPLOAD_SIZE_MB=20

# --- Retrieval / quiz constraints ---
RAG_TOP_K=4
RAG_MAX_TOP_K=12
MAX_SELECTED_DOCS=10
MAX_QUIZ_QUESTIONS=30
MAX_CHAT_CONTEXT_DOCS=5

# --- Request body limits (MB) ---
BODY_LIMIT_MB=1

# --- Rate limits (requests per window) ---
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AI=30
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_GENERAL=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# --- Logging ---
LOG_LEVEL=debug

# --- YouTube (DISABLED by default) ---
# Real YouTube integration requires server-side credentials and quota handling.
# Leave YOUTUBE_ENABLED=false unless you provide a valid YOUTUBE_API_KEY.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=

# --- Admin (optional) ---
# Comma-separated emails granted admin privileges.
ADMIN_EMAILS=
